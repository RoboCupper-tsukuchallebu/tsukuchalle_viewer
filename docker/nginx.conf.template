# nginx の公式イメージが、起動時に定義済みの環境変数だけを置き換える（$http_upgrade などの nginx の変数は残る）。
# VIEWER_PORT: 待ち受けるポート / VIEWER_BRIDGE_PORT: 同じホストの foxglove_bridge のポート
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen ${VIEWER_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # ページと同じ origin の /ws を、同じホストの foxglove_bridge に中継する。
    location = /ws {
        proxy_pass http://127.0.0.1:${VIEWER_BRIDGE_PORT};
        include /etc/nginx/websocket-proxy.conf;
    }
    location = /ws-control {
        if ($viewer_origin_allowed = 0) { return 403; }
        if ($viewer_host_allowed = 0) { return 403; }
        # map の文字列検索は大文字小文字を区別しないため、元の値も照合する。
        if ($http_origin != $viewer_origin_exact) { return 403; }
        if ($http_host != $viewer_host_exact) { return 403; }
        proxy_pass http://127.0.0.1:${VIEWER_CONTROL_BRIDGE_PORT};
        include /etc/nginx/websocket-proxy.conf;
    }

}
