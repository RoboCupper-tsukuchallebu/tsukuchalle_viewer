# compose.yaml が読む。ロボット PC の ~/tsukuchalle_viewer/.env に .env として置く。
# ビューアが待ち受けるポート
VIEWER_PORT=8080
# nginx が /ws を中継する先の foxglove_bridge のポート（同じホストの 127.0.0.1）
VIEWER_BRIDGE_PORT=8765
# 仮の既定。2 本目の bridge の設定に合わせる
VIEWER_CONTROL_BRIDGE_PORT=8766
# 空白区切り。例: http://viewer.example:8080
VIEWER_ALLOWED_ORIGINS=
# 空白区切り。例: viewer.example:8080
VIEWER_ALLOWED_HOSTS=
