  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "ws": "8.22.2"
